# --- Admin auth ---
# Password used to sign in at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign session cookies (e.g. `openssl rand -base64 32`)
AUTH_SECRET=replace-with-a-long-random-string

# --- Google Sheets ---
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Service account credentials (share the sheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks, wrapped in double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Sign in with Google (admin area) ---
# OAuth "Web application" client from Google Cloud Console → Google Auth Platform → Clients.
# Authorised redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Super admins (comma-separated Gmail addresses). Other users are managed in Admin → Users & access.
SUPERADMIN_EMAILS=ahmadzabilalbar@gmail.com

# --- Email sign-in codes (admin login with any email, e.g. name@uum.edu.my) ---
# Gmail: turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# Without SMTP, codes are printed in the server console during local development only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional, defaults to "PERISAI <SMTP_USER>"
MAIL_FROM=
