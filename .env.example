# --- Admin auth ---
# Password used to sign in at /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign session cookies (e.g. `openssl rand -base64 32`)
AUTH_SECRET=replace-with-a-long-random-string

# --- Google Sheets ---
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Service account credentials (share the sheet with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n line breaks, wrapped in double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
